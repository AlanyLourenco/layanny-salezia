{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    { "source": "/(.*)\.(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/marca/(.*)\.(woff2|png)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/painel/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
